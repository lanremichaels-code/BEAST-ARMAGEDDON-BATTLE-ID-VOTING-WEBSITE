# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Choose a strong, private password for your admin dashboard
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Generate a long random secret (at least 32 characters)
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
